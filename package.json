{
  "name": "stratus",
  "description": "Stratus — Open-source script processing tool for video editors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/canefly/stratus.git"
  },
  "private": true,
  "version": "1.2.1",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:sidecar": "src-tauri\\sidecars\\venv\\Scripts\\pyinstaller --clean src-tauri/sidecars/parser.spec && powershell -Command \"Copy-Item -Path dist/parser.exe -Destination src-tauri/bin/parser-x86_64-pc-windows-msvc.exe -Force\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
